# Git ignore rules: Python caches/build artifacts, virtualenvs, cached raw data
# (data/*.csv) and generated charts. Keeps the repo to source + docs only.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Cached data (do not version raw data)
data/*.csv
!data/.gitkeep

# Generated plots
*.png
